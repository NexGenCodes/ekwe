+const FILES = ["armeabi-v7a.zip", "arm64-v8a.zip", "x86.zip", "x86_64.zip", "ffmpeg_ios.zip", "iphoneos.zip", "iphonesimulator.zip", "jniLibs.zip"];
+
+const isAndroid = process.argv[2] === 'android';
+const skipFfmpeg = process.argv[3] === 'skipffmpeg';
+
+const audioApiRoot = path.resolve(__dirname, '..');
