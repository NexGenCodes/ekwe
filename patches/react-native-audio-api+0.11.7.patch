+    if ((folder === 'ffmpeg_ios' || folder === 'jniLibs') && skipFfmpeg) continue;
+    let out = (name === 'jniLibs.zip') ? (isAndroid ? dstJniLibs : null) : dstNormal;
+    if (!out) continue;
+    if (fs.existsSync(path.join(out, folder))) continue;
+    console.log("[AudioAPI] Downloading: " + name);
+    try {
+      await download(url, zip);
+      if (!fs.existsSync(out)) fs.mkdirSync(out, { recursive: true });
+      execSync("tar -xf \"" + zip + "\" -C \"" + out + "\"");
+    } catch (e) {
+      console.error("[AudioAPI] Error " + name + ":", e.message);
+    }
+  }
+  if (fs.existsSync(tempDir)) fs.rmSync(tempDir, { recursive: true, force: true });
+}
+run();
