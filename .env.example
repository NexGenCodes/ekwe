# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Used by: npm run analytics:sync (scripts/analytics/sync-posthog.mjs)
# Never commit .env.

# PostHog personal API key — https://us.posthog.com/settings/user-api-keys
# Server-side secret. Project secret keys ("phs_") return 401 on these endpoints.
POSTHOG_PROJECT_API_KEY=phx_your_personal_api_key
# Numeric PostHog project id — Project settings → Project variables
POSTHOG_PROJECT_ID=123456
# PostHog app host (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
POSTHOG_HOST=https://us.i.posthog.com