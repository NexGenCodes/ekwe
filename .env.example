# Example .env file for local development
# Copy this to .env and fill in real values (do NOT commit .env)

# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
# Example: postgres://user:password@localhost:5432/dbname
DATABASE_URL=

# API keys / secrets
API_KEY=
SECRET_KEY=

# Google Sign-In (Expo public env vars)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Feature flags
ENABLE_DEBUG=false
