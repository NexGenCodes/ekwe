{
  "expo": {
    "name": "EKWE",
    "slug": "ekwe",
    "version": "1.0.0",
    "scheme": "ekwe",
    "orientation": "portrait",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#09090B"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ekwe.app",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ekwe uses your microphone to capture your voice for real-time translation.",
        "NSSpeechRecognitionUsageDescription": "Ekwe uses speech recognition to convert your spoken words into text for translation.",
        "NSUserTrackingUsageDescription": "This identifier helps us deliver a better experience and improve our services."
      },
      "privacyManifests": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-light.png",
        "backgroundColor": "#FAFAFA",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "package": "com.ekwe.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/Outfit-Regular.ttf",
            "assets/fonts/Outfit-Medium.ttf",
            "assets/fonts/Outfit-Bold.ttf",
            "assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "reactNativeArchitectures": "arm64-v8a,armeabi-v7a",
            "ndkVersion": "27.0.12077973"
          }
        }
      ],

      "./modules/ekwe-native/app.plugin.js",
      "expo-router",
      "expo-audio",
      "expo-image",
      "@sentry/react-native",
      "expo-apple-authentication",
      "expo-secure-store"
    ],
    "assetBundlePatterns": ["assets/fonts/*"]
  }
}
