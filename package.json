{
  "name": "ekwe-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "android": "turbo run android",
    "ios": "turbo run ios",
    "gen:tokens": "node scripts/tokens/gen-tokens.mjs",
    "gen:env": "node scripts/tokens/gen-env.mjs",
    "gen:icons": "node scripts/icons/generate-icons.mjs",
    "release": "node scripts/release.mjs",
    "migrate:push": "supabase db push --linked",
    "migrate:stage": "supabase migration new",
    "migrate:status": "supabase migration list",
    "seed": "supabase db seed --linked",
    "email:deploy": "bash supabase/deploy-email-templates.sh",
    "db:link": "bash -c 'set -a; source supabase/.env; set +a; supabase link --project-ref $SUPABASE_PROJECT_REF'",
    "prepare": "husky"
  },
  "dependencies": {
    "libopus-wasm": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=18"
  }
}
