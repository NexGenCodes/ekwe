{
  "name": "ekwe-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:secrets": "node --test scripts/deploy-keys.test.mjs scripts/check-migrations.test.mjs",
    "test:ci": "pnpm test:secrets && turbo run test:ci",
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "android": "turbo run android",
    "ios": "turbo run ios",
    "gen:tokens": "node scripts/tokens/gen-tokens.mjs",
    "gen:env": "node scripts/tokens/gen-env.mjs",
    "gen:icons": "node scripts/icons/generate-icons.mjs",
    "analytics:sync": "node --env-file-if-exists=apps/mobile/.env scripts/analytics/sync-posthog.mjs",
    "db:generate:local": "pnpm --filter @ekwe/mobile db:generate",
    "db:migrate": "pnpm --filter @ekwe/worker db:migrate",
    "db:check": "node scripts/check-migrations.mjs",
    "db:seed:config": "node scripts/seed-app-config.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "seed": "pnpm db:seed:config",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=18"
  },
  "version": "1.3.0"
}
