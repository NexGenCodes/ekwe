{
  "name": "ekwe",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-config": "~55.0.9",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "^55.0.11",
    "expo-asset": "~55.0.12",
    "expo-audio": "~55.0.11",
    "expo-blur": "~55.0.12",
    "expo-build-properties": "~55.0.11",
    "expo-clipboard": "~55.0.11",
    "expo-constants": "~55.0.11",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.11",
    "expo-keep-awake": "~55.0.6",
    "expo-linking": "~55.0.11",
    "expo-speech-recognition": "^3.1.2",
    "expo-splash-screen": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.13",
    "franc-min": "^6.2.0",
    "lucide-react-native": "^1.7.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.2",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^15.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.13",
    "jest-mock-extended": "^4.0.0",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-mmkv|react-native-worklets|lucide-react-native)"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.ts",
      "src/constants/**/*.ts",
      "src/types/**/*.ts",
      "src/store/**/*.ts",
      "src/hooks/**/*.ts",
      "!src/utils/index.ts",
      "!src/utils/sentry.ts",
      "!src/constants/mockData.ts",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/utils/": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
