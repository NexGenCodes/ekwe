{
  "expo": {
    "name": "EKWE",
    "slug": "ekwe",
    "version": "1.0.0",
    "scheme": "ekwe",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ekwe.app",
      "userInterfaceStyle": "automatic",
      // Apple Team ID required by @bacons/apple-targets for the ShareExtension
      // target. Replace with your team ID (Xcode → Signing & Capabilities).
      "appleTeamId": "REPLACE_WITH_YOUR_APPLE_TEAM_ID",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ekwe uses your microphone to capture your voice for real-time translation.",
        "NSSpeechRecognitionUsageDescription": "Ekwe uses speech recognition to convert your spoken words into text for translation.",
        "NSUserTrackingUsageDescription": "This identifier helps us deliver a better experience and improve our services."
      },
      "privacyManifests": {}
    },
    "android": {
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/monochrome.png"
      },
      "package": "com.ekwe.app",
      "backgroundColor": "#FFFFFF",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/Outfit-Regular.ttf",
            "assets/fonts/Outfit-Medium.ttf",
            "assets/fonts/Outfit-Bold.ttf",
            "assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "reactNativeArchitectures": "arm64-v8a,armeabi-v7a",
            "ndkVersion": "27.1.12297006"
          }
        }
      ],

      "expo-localization",
      "expo-status-bar",
      "./modules/ekwe-native/app.plugin.js",
      "expo-router",
      "expo-audio",
      "expo-image",
      "@sentry/react-native",
      "expo-apple-authentication",
      "expo-secure-store",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFFFFF",
          "defaultChannel": "updates"
        }
      ]
    ],
    "assetBundlePatterns": ["assets/fonts/*"],
    "updates": {
      "url": "https://u.expo.dev/YOUR_PROJECT_ID",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_PROJECT_ID"
      }
    }
  }
}
