{
  "expo": {
    "name": "EKWE",
    "slug": "ekwe",
    "version": "1.1.1",
    "scheme": "ekwe",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ekwe.app",
      "userInterfaceStyle": "automatic",
      "appleTeamId": "REPLACE_WITH_YOUR_APPLE_TEAM_ID",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ekwe uses your microphone to capture your voice for real-time translation.",
        "NSSpeechRecognitionUsageDescription": "Ekwe uses speech recognition to convert your spoken words into text for translation.",
        "NSUserTrackingUsageDescription": "This identifier helps us deliver a better experience and improve our services."
      },
      "privacyManifests": {}
    },
    "android": {
      "versionCode": 10101,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/monochrome.png"
      },
      "package": "com.ekwe.app",
      "backgroundColor": "#FFFFFF",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/Outfit-Regular.ttf",
            "assets/fonts/Outfit-Medium.ttf",
            "assets/fonts/Outfit-Bold.ttf",
            "assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "./modules/ekwe-native/app.plugin.js",
      "expo-router",
      "expo-audio",
      "expo-image",
      "@sentry/react-native",
      "expo-apple-authentication",
      "expo-secure-store",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFFFF",
          "defaultChannel": "updates"
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/fonts/*"
    ],
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.ekwe.app.EchoShare",
                  "targetName": "ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.ekwe.app"
                    ],
                    "keychain-access-groups": [
                      "$(AppIdentifierPrefix)com.ekwe.app",
                      "$(AppIdentifierPrefix)com.ekwe.app.EchoShare"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "fb3d49de-0c12-4b1a-bf94-863befec071a"
      }
    },
    "owner": "nexgen_codes"
  }
}
