{
  "name": "ekwe",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "EXPO_PUBLIC_DEV_ARCH=$(adb shell getprop ro.product.cpu.abi | tr -d '\\r' || echo 'arm64-v8a') expo run:android",
    "prebuild": "node ../../scripts/tokens/gen-tokens.mjs && node ../../scripts/icons/generate-icons.mjs && expo prebuild",
    "prebuild:ios": "node ../../scripts/tokens/gen-tokens.mjs && node ../../scripts/icons/generate-icons.mjs && expo prebuild --platform ios",
    "prebuild:android": "node ../../scripts/tokens/gen-tokens.mjs && node ../../scripts/icons/generate-icons.mjs && expo prebuild --platform android",
    "clean:native": "bash ../../scripts/clean-native.sh",
    "clean:android": "bash ../../scripts/clean-native.sh --android",
    "clean:ios": "bash ../../scripts/clean-native.sh --ios",
    "release:android": "APP_ENV=production expo run:android --variant release",
    "ios": "if xcrun devicectl list devices 2>/dev/null | grep -qiE 'iPhone|iPad'; then expo run:ios --device; else expo run:ios; fi",
    "release:ios": "if xcrun devicectl list devices 2>/dev/null | grep -qiE 'iPhone|iPad'; then APP_ENV=production expo run:ios --configuration Release --device; else APP_ENV=production expo run:ios --configuration Release; fi",
    "eas:build:dev:android": "eas build --profile development --platform android --clear",
    "eas:build:dev:ios": "eas build --profile development --platform ios --clear",
    "eas:build:release:android": "eas build --profile preview --platform android",
    "eas:build:release:ios": "eas build --profile preview --platform ios",
    "eas:build:prod:android": "eas build --profile production --platform android",
    "eas:build:prod:ios": "eas build --profile production --platform ios",
    "build": "APP_ENV=production EAS_BUILD=true expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "knip:check": "knip",
    "prepare": ""
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@ekwe/shared": "workspace:*",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.8",
    "@hookform/resolvers": "^5.2.2",
    "@legendapp/state": "^2.1.15",
    "@op-engineering/op-sqlite": "^16.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/metro-config": "0.86.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.100.14",
    "ekwe-native": "workspace:*",
    "expo": "^57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.8.0",
    "posthog-react-native": "^4.46.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.26.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.5",
    "eas-cli": "^21.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "knip": "^6.4.1",
    "prettier": "^3.8.1",
    "react-refresh": "^0.18.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "op-sqlite": {
    "fts5": true
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
