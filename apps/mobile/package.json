{
  "name": "@ekwe/mobile",
  "version": "1.2.10",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "bash ../../scripts/run-android.sh",
    "prebuild": "bash ../../scripts/prebuild-clean.sh && node ../../scripts/tokens/gen-tokens.mjs && node ../../scripts/icons/generate-icons.mjs && expo prebuild",
    "prebuild:ios": "bash ../../scripts/prebuild-clean.sh ios && node ../../scripts/tokens/gen-tokens.mjs && node ../../scripts/icons/generate-icons.mjs && expo prebuild --platform ios",
    "prebuild:android": "bash ../../scripts/prebuild-clean.sh android && node ../../scripts/tokens/gen-tokens.mjs && node ../../scripts/icons/generate-icons.mjs && expo prebuild --platform android",
    "clean:native": "bash ../../scripts/clean-native.sh",
    "clean:android": "bash ../../scripts/clean-native.sh --android",
    "clean:ios": "bash ../../scripts/clean-native.sh --ios",
    "release:android": "APP_ENV=production expo run:android --variant release",
    "ios": "if xcrun devicectl list devices 2>/dev/null | grep -qiE 'iPhone|iPad'; then expo run:ios --device; else expo run:ios; fi",
    "release:ios": "if xcrun devicectl list devices 2>/dev/null | grep -qiE 'iPhone|iPad'; then APP_ENV=production expo run:ios --configuration Release --device; else APP_ENV=production expo run:ios --configuration Release; fi",
    "build": "APP_ENV=production EAS_BUILD=true expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0 && prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e:ios": "maestro test .maestro/",
    "test:e2e:android": "maestro test .maestro/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "knip:check": "knip",
    "prepare": ""
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@ekwe/db": "workspace:*",
    "@ekwe/shared": "workspace:*",
    "@expo/metro-runtime": "~57.0.15",
    "@hookform/resolvers": "^5.2.2",
    "@legendapp/state": "^2.1.15",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@sentry/react-native": "~8.27.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.100.14",
    "drizzle-orm": "^0.45.2",
    "expo": "^57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "^57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.20",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "flutterwave-react-native-sdk": "^1.0.7",
    "lucide-react-native": "^1.8.0",
    "posthog-react-native": "^4.46.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.26.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@eslint/js": "^9.39.4",
    "@expo/config-plugins": "~57.0.9",
    "@sentry/cli": "^3.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "~19.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jsdom": "^30.0.1",
    "knip": "^6.4.1",
    "prettier": "^3.8.1",
    "react-refresh": "^0.18.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.6"
  },
  "private": true
}
