# Mobile app — copy to .env and fill in real values (do NOT commit .env)
#
# Required for local dev / EAS builds:

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_WORKER_URL=https://your-worker.dev
# Dev-only override for the active payment provider. Set to "flutterwave" to
# force that provider from this file, overriding the payment_config row in
# Supabase. Leave empty to use the server default.
EXPO_PUBLIC_DEFAULT_PROVIDER=
EXPO_PUBLIC_ITUNES_ITEM_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CONTACT_EMAIL=
EXPO_PUBLIC_TURNSTILE_SITEKEY=
# Widget origin for the iOS share extension's Turnstile host (default: https://ekwe.pages.dev)
EXPO_PUBLIC_TURNSTILE_BASE_URL=https://ekwe.pages.dev
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
EXPO_PUBLIC_POSTHOG_API_KEY=
# Must match the project's region: https://us.i.posthog.com (US Cloud) or
# https://eu.i.posthog.com (EU Cloud).
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Flutterwave — NEED: Flutterwave Dashboard → Settings → API
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-431faadc1b0f600baf9b2004f4974573-X
EXPO_PUBLIC_FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTe4a8c93f9420

