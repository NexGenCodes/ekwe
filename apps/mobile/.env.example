# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Mobile app — do NOT commit .env.
# EXPO_PUBLIC_* values ship inside the app bundle and are public.

EXPO_PUBLIC_ENV=production

# Cloudflare Worker URL — Cloudflare Dashboard → Workers & Pages → ekwe-proxy → Preview/Deploy
EXPO_PUBLIC_WORKER_URL=https://ekwe-proxy.ekwe.workers.dev

# Dev-only override for the active payment provider.
# Overrides the payment_config row in Supabase; leave empty for the server default.
EXPO_PUBLIC_DEFAULT_PROVIDER=

# Flutterwave — https://dashboard.flutterwave.com/settings/apis
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
EXPO_PUBLIC_FLUTTERWAVE_ENCRYPTION_KEY=

# Cloudflare Turnstile — dashboard → Turnstile → widget "ekwe-app" (managed mode)
# Site key goes here; the matching secret lives in the worker as TURNSTILE_SECRET.
# When set, OTP sends route through the worker for bot verification.
EXPO_PUBLIC_TURNSTILE_SITEKEY=
# Optional: override the widget's origin (defaults to https://ekwe.pages.dev)
EXPO_PUBLIC_TURNSTILE_BASE_URL=

# Apple App Store Connect — App → App Store → App Information → Apple ID
EXPO_PUBLIC_ITUNES_ITEM_ID=

# Sentry — main org is 'public-benefit-nonprofit' (owns BOTH mobile's
# react-native project and the worker's node-cloudflare-workers project).
# Kept in sync with apps/worker/wrangler.jsonc SENTRY_DSN (same org).
EXPO_PUBLIC_SENTRY_DSN=

# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Firebase App Check — debug provider token (dev + sideloaded prod builds).
# Register the value in Firebase Console → Build → App Check → your app →
# Manage debug tokens. Leave empty to use Play Integrity/App Attest in release
# builds (requires Play Store / App Store distribution) or the auto-generated
# debug secret in dev (printed to logcat). Do NOT commit a real token here —
# commit only this empty line.
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Google Cloud Console — https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Support contact email shown in-app
EXPO_PUBLIC_CONTACT_EMAIL=support@example.com

# Sentry — org/project/auth for source-map upload. Same main org as the DSN
# above. Auth token from Sentry → User settings → User auth tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=sntryu_your_auth_token

# PostHog project key + host — https://us.posthog.com/settings/project#variables
# Client-side public key (starts with "phc_"); never use the phx_ personal key here.
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_client_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Used by: npm run analytics:sync (scripts/analytics/sync-posthog.mjs)
# PostHog personal API key — https://us.posthog.com/settings/user-api-keys
# Server-side secret. Project secret keys ("phs_") return 401 on these endpoints.
POSTHOG_PROJECT_API_KEY=phx_your_personal_api_key
# Numeric PostHog project id — Project settings → Project variables
POSTHOG_PROJECT_ID=123456
# PostHog app host (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
POSTHOG_HOST=https://us.i.posthog.com