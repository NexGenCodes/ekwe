# Cloudflare R2 credentials (for APK uploads via GitHub Actions)
# Not needed for local builds
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Support email shown on the site (terms/privacy + footer link)
# Overrides the value in config.json; fallback is config.json's contact.email.
CONTACT_EMAIL=
