{
  "name": "worker",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:coverage": "vitest run --project unit --coverage",
    "check:keys": "node tests/helpers/check-providers.mjs",
    "check:keys:all": "node tests/helpers/check-providers.mjs --groq",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "knip:check": "knip"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ekwe/shared": "workspace:*",
    "franc": "^6.2.0",
    "jose": "^6.2.3",
    "libopus-wasm": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.0",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.5.0",
    "knip": "^6.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.6",
    "wrangler": "^4.102.0"
  }
}
