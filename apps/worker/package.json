{
  "name": "@ekwe/worker",
  "version": "1.3.0",
  "description": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run --project unit && vitest run --project workers",
    "test:ci": "vitest run --project unit --coverage",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run src/__tests__/providers/providers-check.test.ts",
    "test:coverage": "vitest run --project unit --coverage",
    "check:keys": "node src/__tests__/helpers/check-providers.mjs",
    "check:keys:all": "node src/__tests__/helpers/check-providers.mjs --groq",
    "secrets:check": "node ../../scripts/deploy-keys.mjs check",
    "secrets:sync-remote": "node ../../scripts/deploy-keys.mjs sync-remote",
    "secrets:verify": "node ../../scripts/deploy-keys.mjs verify",
    "secrets:rotate": "node ../../scripts/deploy-keys.mjs rotate",
    "db:migrate": "wrangler d1 migrations apply ekwe --remote",
    "db:migrate:local": "wrangler d1 migrations apply ekwe --local",
    "dev": "wrangler dev --persist-to .wrangler/state",
    "deploy:worker": "wrangler deploy",
    "gen:types": "wrangler types",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "knip:check": "knip",
    "check:stt": "node src/__tests__/helpers/check-stt.mjs",
    "check:tts": "node src/__tests__/helpers/check-tts.mjs",
    "check:stream": "vitest run --project workers src/__tests__/durable/check-stream.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ekwe/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/cloudflare": "^10.70.0",
    "drizzle-orm": "0.45.3",
    "franc": "^6.2.0",
    "hono": "^4.13.12",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.0",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.5.0",
    "knip": "^6.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.6",
    "wrangler": "^4.149.0",
    "zod": "^4.6.5"
  }
}
