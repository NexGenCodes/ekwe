# Worker local dev secrets — copy to `.dev.vars` and fill in real values
# Cloudflare Dashboard → Workers & Pages → ekwe-proxy → Settings → Variables
# DO NOT commit `.dev.vars`. This file is a safe, documented template.

APP_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudflare Turnstile ─────────────────────────────────────────────
# Optional: for web clients on /auth/otp (OTP send). Widget "ekwe-app" (managed
# mode) in Cloudflare dashboard. Paste its SECRET key here.
TURNSTILE_SECRET=
# Comma-separated allowed hostnames the widget can render on (siteverify).
# For web: your domain(s). For mobile WebView: the baseUrl domain.
TURNSTILE_HOSTNAMES=ekwe.app

# ─── STT / TTS Providers (multiply-keys = failover rotation) ──────────
# Required: at least one working key per provider you intend to use.
DEEPGRAM_KEY_1=
DEEPGRAM_KEY_2=
DEEPGRAM_KEY_3=

GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=
GROQ_KEY_5=
GROQ_KEY_6=
GROQ_KEY_7=
GROQ_KEY_8=
GROQ_KEY_9=
GROQ_KEY_10=

GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=

COHERE_KEY_1=
COHERE_KEY_2=
COHERE_KEY_3=

GLADIA_KEY_1=
GLADIA_KEY_2=
GLADIA_KEY_3=
GLADIA_KEY_4=
GLADIA_KEY_5=

ASSEMBLYAI_KEY_1=
ASSEMBLYAI_KEY_2=
ASSEMBLYAI_KEY_3=

MISTRAL_KEY_1=
MISTRAL_KEY_2=
MISTRAL_KEY_3=
MISTRAL_KEY_4=
MISTRAL_KEY_5=

OPENROUTER_KEY=

# ─── Wit.ai (per-language keys) ───────────────────────────────────────
