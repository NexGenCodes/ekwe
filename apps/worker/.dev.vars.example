# Worker local dev secrets — copy to `.dev.vars` and fill in real values
# Cloudflare Dashboard → Workers & Pages → ekwe-proxy → Settings → Variables
# DO NOT commit `.dev.vars`. This file is a safe, documented template.

APP_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: secret API key (sb_secret_...) from Authentication → API Keys. When
# set, the OTP route forwards the end-user IP (Sb-Forwarded-For) to Supabase Auth
# so its per-IP rate-limit buckets key on each client instead of the worker egress IP.
SUPABASE_SECRET_KEY=your-secret-key

# ─── Speech cache URLs ─────────────────────────────────────────────────
# Signs the `/speech/:key` capability URL so a cache key cannot be recomputed
# from the text and language alone. Any random 32+ byte value; the worker only
# ever HMACs with it. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset, so
# setting this is recommended but not required.
# Deploy with: wrangler secret put SPEECH_URL_SECRET
SPEECH_URL_SECRET=

# ─── Cloudflare Turnstile ─────────────────────────────────────────────
# Optional: for web clients on /auth/otp (OTP send). Widget "ekwe-app" (managed
# mode) in Cloudflare dashboard. Paste its SECRET key here.
TURNSTILE_SECRET=
# Comma-separated allowed hostnames the widget can render on (siteverify).
# For web: your domain(s). For mobile WebView: the baseUrl domain.
TURNSTILE_HOSTNAMES=ekwe.app

# ─── STT / TTS Providers (multiply-keys = failover rotation) ──────────
# Required: at least one working key per provider you intend to use.
# DEEPGRAM_KEY_* also powers Aura-2 speech (7 languages) on the PREMIUM
# speech pipeline.
DEEPGRAM_KEY_1=
DEEPGRAM_KEY_2=
DEEPGRAM_KEY_3=

GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=
GROQ_KEY_5=
GROQ_KEY_6=
GROQ_KEY_7=
GROQ_KEY_8=
GROQ_KEY_9=
GROQ_KEY_10=

GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=

COHERE_KEY_1=
COHERE_KEY_2=
COHERE_KEY_3=

GLADIA_KEY_1=
GLADIA_KEY_2=
GLADIA_KEY_3=
GLADIA_KEY_4=
GLADIA_KEY_5=

ASSEMBLYAI_KEY_1=
ASSEMBLYAI_KEY_2=
ASSEMBLYAI_KEY_3=

MISTRAL_KEY_1=
MISTRAL_KEY_2=
MISTRAL_KEY_3=
MISTRAL_KEY_4=
MISTRAL_KEY_5=

OPENROUTER_KEY_1=
OPENROUTER_KEY_2=

# Optional: overrides the built-in TrustedClientToken used by the Edge TTS
# provider. Set this if Microsoft rotates/revokes the bundled token.
EDGE_CLIENT_TOKEN=

# ─── Payments ──────────────────────────────────────────────────────────
# Required for /billing/checkout and /webhook to work.
# FLUTTERWAVE_SECRET: API secret key (FLWSECK_...) for checkout/payment calls.
FLUTTERWAVE_PUBLIC=
FLUTTERWAVE_SECRET=
UPDATE_NOTIFY_SECRET=

# FLUTTERWAVE_WEBHOOK_SECRET: secret hash from the Flutterwave dashboard
# (Settings → Webhooks), used to verify inbound webhook signatures.
# Must match the value entered in the dashboard. Flutterwave caps this field
# at 36 characters.
FLUTTERWAVE_WEBHOOK_SECRET=
