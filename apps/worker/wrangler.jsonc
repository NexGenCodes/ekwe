{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ekwe-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],

  // Daily cron: cache cleanup, history retention, tombstone + R2 purge,
  // Flutterwave reconciliation. History retention per shared/retention.ts
  // (free 7d, paid 30d). Fetched in scheduled handler.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://ekwe.pages.dev",
    "FIREBASE_PROJECT_NUMBER": "239869950724",
    "REQUIRE_APP_CHECK": "false",
    "TURNSTILE_HOSTNAMES": "ekwe.pages.dev",
    "SENTRY_DSN": "https://47d4580978ca72b625ee6460335410bd@o4510603967332352.ingest.us.sentry.io/4511942034259968",
    "APP_ENV": "production",
    "JWT_ISSUER": "https://ekwe-proxy.ekwe.workers.dev",
    "JWT_PUBLIC_JWK": "{\"crv\":\"Ed25519\",\"x\":\"mvDDmzCiZLRU-8zu_b_OBM5FA5xVX7JaJwrvdrfr7UI\",\"kty\":\"OKP\"}",
    "APPLE_BUNDLE_ID": "com.ekwe.app",
    "GOOGLE_CLIENT_IDS": "508960750849-jo3qc5r65ip3oc6e8e3pc8ju9vacjko1.apps.googleusercontent.com,508960750849-u120m2v71v74uk9dbmfd06neppsc732h.apps.googleusercontent.com",
    // sync push cap: Free 25 rows, Paid 200 rows (shared/sync.ts). Default = Free.
    "WORKERS_PAID": "false",
    "BREVO_SENDER": "emmanuelforchinagorom@gmail.com",
    "BREVO_SENDER_NAME": "Ekwe",
    "ADMIN_EMAILS": "emmanuelforchinagorom@gmail.com",
    "CF_ACCESS_ISSUER": "https://old-scene-5c9b.cloudflareaccess.com",
    "CF_ACCESS_AUDIENCE": "dd4230064d6b8b06d8cc1b5fbf73227e66105783124e1ea0c0b563d64cc91718"
  },

  // Paid override: deploy with `wrangler deploy --env paid` once account
  // moves to Workers Paid. Default deploy (no --env) works on Free.
  "env": {
    "paid": {
      "name": "ekwe-proxy",
      "vars": {
        "WORKERS_PAID": "true"
      },
      "limits": {
        "cpu_ms": 300000
      }
    }
  },

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  "kv_namespaces": [
    {
      "binding": "EKWE_KV",
      "id": "2a61656b51414ff4ae7cbc13a53fb459"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ekwe",
      "database_id": "6444e108-7b53-4e69-89d3-66c8e805f31e"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SPEECH_CACHE",
      "bucket_name": "ekwe-speech-cache"
    }
  ],

  "analytics_engine_datasets": [
    {
      "binding": "EKWE_ANALYTICS",
      "dataset": "ekwe_provider"
    }
  ],

  // 500/min per key per edge (keyed by userId::clientIp in middleware).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "28401",
      "simple": { "limit": 500, "period": 60 }
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "durable_objects": {
    "bindings": [
      {
        // Live-transcription sessions. One DO per user (getByName(userId)).
        "name": "STREAM_DO",
        "class_name": "StreamDurableObject"
      },
      {
        // OTP throttle. 8 shards (getByName(otp-N)) by hash, not single instance.
        "name": "THROTTLE_DO",
        "class_name": "ThrottleBucket"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StreamDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ThrottleBucket"]
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_RETRY_QUEUE",
        "queue": "ekwe-webhook-retry"
      },
      {
        "binding": "RECONCILIATION_QUEUE",
        "queue": "ekwe-reconciliation-retry"
      }
    ],
    "consumers": [
      {
        "queue": "ekwe-webhook-retry",
        "max_retries": 12,
        "dead_letter_queue": "ekwe-webhook-dlq"
      },
      {
        "queue": "ekwe-reconciliation-retry",
        "max_retries": 12,
        "dead_letter_queue": "ekwe-reconciliation-dlq"
      }
    ]
  }
}
