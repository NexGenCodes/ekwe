{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ekwe-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],

  // WASM module bundling

  // Daily history retention cleanup (free: 30d, pro: 365d) — calls
  // cleanup_expired_history via the service role in the `scheduled` handler.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  // Billing provider secrets (set via `wrangler secret put <NAME>`):
  // - FLUTTERWAVE_SECRET: Flutterwave API secret key (FLWSECK_... or
  //   FLWSECK_TEST-...). In production this MUST be a live key: a test-mode
  //   secret would let anyone bypass payment and grant Pro for free.
  // - FLUTTERWAVE_PUBLIC: matching Flutterwave public key (FLWPUBK_... or
  //   FLWPUBK_TEST-...). Returned to the client in the checkout response so
  //   the SDK always charges against the key matching the configured secret.
  // - FLUTTERWAVE_WEBHOOK_SECRET: webhook secret hash from the Flutterwave
  //   dashboard (Settings → Webhooks); used to verify inbound webhooks
  //   (`verif-hash` plain equality and/or `flutterwave-signature` HMAC-SHA256).
  // - UPDATE_NOTIFY_SECRET: shared secret (Authorization: Bearer) for the release
  //   workflow's POST /admin/update/notify and POST /admin/update/manifest endpoints.
  // Must be identical to the GitHub Actions secret `UPDATE_NOTIFY_SECRET`.
  // Never commit secrets to this file — use `.dev.vars` for local development.

  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },

  "vars": {
    "SUPABASE_URL": "https://zsjcgebczzbmaarfcdny.supabase.co",
    "ALLOWED_ORIGINS": "https://ekwe.pages.dev",
    "FIREBASE_PROJECT_NUMBER": "239869950724",
    "REQUIRE_APP_CHECK": "false",
    // Frontend hostnames Turnstile siteverify must return for /auth/otp.
    // The Turnstile widget must be registered for these domains (add localhost for
    // local dev via .dev.vars — never in this production default).
    "TURNSTILE_HOSTNAMES": "ekwe.pages.dev",
    // Sentry DSN for worker error tracking. Public key — safe in this file.
    // When empty/absent, the Sentry SDK is not initialized and the worker
    // behaves as before (no error reporting).
    "SENTRY_DSN": "https://47d4580978ca72b625ee6460335410bd@o4510603967332352.ingest.us.sentry.io/4511942034259968",
    // Default to production so deploys never ship with debug logging / dev CORS.
    // Override to "development" locally via .dev.vars (precedence over vars).
    "APP_ENV": "production"
  },

  // Wit.ai keys stored as pooled JSON maps in the account Secrets Store
  // (store "ekwe-secrets"). Each pool holds ~17 languages ({"AF": "..."}).
  // Read via `await env.WIT_POOL_<N>.get()` (see src/utils/wit-pools.ts).
  // Names/IDs only — the secret values live in the store, never here.
  "secrets_store_secrets": [
    { "binding": "WIT_POOL_01", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_01" },
    { "binding": "WIT_POOL_02", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_02" },
    { "binding": "WIT_POOL_03", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_03" },
    { "binding": "WIT_POOL_04", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_04" },
    { "binding": "WIT_POOL_05", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_05" },
    { "binding": "WIT_POOL_06", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_06" },
    { "binding": "WIT_POOL_07", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_07" },
    { "binding": "WIT_POOL_08", "store_id": "5a18c7b65511452a9d7e1d7999831974", "secret_name": "WIT_POOL_08" }
  ],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  // KV: blacklist, TTS cache, FX rates, webhook idempotency, preflight cache
  "kv_namespaces": [
    {
      "binding": "EKWE_KV",
      "id": "2a61656b51414ff4ae7cbc13a53fb459"
    }
  ],

  // D1 translation/transcription cache — 100K writes/day free (100x KV's 1K).
  // Created via: wrangler d1 create ekwe-cache
  "d1_databases": [
    {
      "binding": "EKWE_D1",
      "database_name": "ekwe-cache",
      "database_id": "1af43324-74dd-40c5-9bb8-e2e70588e16f"
    }
  ],

  // R2 large speech-audio cache. Small clips stay in KV (hot, low latency);
  // audio above SPEECH_KV_CACHE_MAX_BYTES is stored here so long-form TTS output
  // is never re-generated. Create the bucket before deploying:
  //   wrangler r2 bucket create ekwe-speech-cache
  "r2_buckets": [
    {
      "binding": "SPEECH_CACHE",
      "bucket_name": "ekwe-speech-cache"
    }
  ],

  // Analytics Engine dataset for provider-pipeline telemetry (per-attempt
  // outcomes, latency, error class, preflight/usage events). The dataset is
  // created automatically on the first write from a deployed Worker — no
  // out-of-band setup needed. Query via `wrangler insights` or the SQL HTTP API.
  "analytics_engine_datasets": [
    {
      "binding": "EKWE_ANALYTICS",
      "dataset": "ekwe_provider"
    }
  ],

  // Rate limit: 500 requests per minute per KEY per edge location — NOT a
  // global cap. The pipeline keys by `auth.userId::clientIp` (see
  // core/pipeline.ts), so each signed-in user gets their own 500/min budget
  // at each Cloudflare location. Generous for a burst guard; abuse throttling
  // (OTP) lives in the DO counters and per-route preflight gates.
  // namespace_id derived from worker name ("ekwe-proxy"): proxy=28401.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "28401",
      "simple": { "limit": 500, "period": 60 }
    }
  ],

  // Cloudflare Workers AI binding
  "ai": {
    "binding": "AI"
  },

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        // Live-transcription sessions. One DO instance per user (getByName(userId))
        // so WebSockets survive worker-isolate churn and idle sessions can hibernate.
        "name": "STREAM_DO",
        "class_name": "StreamDurableObject"
      },
      {
        // OTP send throttling. A single instance (getByName("otp")) holds per-IP /
        // per-email counters. Replaces the KV counter, which had no atomic increment
        // and capped writes to the same key at 1/sec (a spammer's burst silently
        // stopped the count from rising). DO storage is strongly consistent.
        "name": "THROTTLE_DO",
        "class_name": "ThrottleBucket"
      }
    ]
  },

  // Queue: maintenance tasks (cleanup_expired_history RPC). The DLQ
  // (ekwe-maintenance-dlq) is consumed by this same script: messages that
  // exhausted ekwe-maintenance's retries are reported to Sentry via the
  // queue handler and acked, so they never linger (DLQ messages auto-delete
  // after 4 days even without a consumer).
  "queues": {
    "producers": [
      {
        "binding": "MAINTENANCE_QUEUE",
        "queue": "ekwe-maintenance"
      }
    ],
    "consumers": [
      {
        "queue": "ekwe-maintenance",
        "max_retries": 3,
        "dead_letter_queue": "ekwe-maintenance-dlq"
      },
      {
        "queue": "ekwe-maintenance-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 2
      }
    ]
  },

  // DO migrations — new SQLite-backed classes
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StreamDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ThrottleBucket"]
    }
  ]
}
