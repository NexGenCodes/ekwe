{
  "expo": {
    "name": "ekwe",
    "slug": "ekwe",
    "version": "1.0.0",
    "scheme": "ekwe",
    "orientation": "portrait",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#09090B"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ekwe",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-light.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "package": "com.anonymous.ekwe"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon-light.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DMSerifDisplay-Regular.ttf",
            "./assets/fonts/Outfit-Regular.ttf",
            "./assets/fonts/Outfit-Medium.ttf",
            "./assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-speech-recognition",
      "expo-widgets",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildArchs": ["arm64-v8a"],
            "ndkVersion": "27.0.12077973"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/plain", 
            "audio/*", 
            "application/octet-stream"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "This app requires access to the microphone to record audio.",
          "androidPermissions": [
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.RECORD_AUDIO",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE"
          ],
          "androidForegroundService": true,
          "androidFSTypes": ["mediaPlayback", "microphone"]
        }
      ],
      "./modules/ekwe-native/app.plugin.js",
      "expo-secure-store",
      "expo-router"
    ],
    "assetBundlePatterns": ["assets/fonts/*"]
  }
}
