{
  "expo": {
    "name": "ekwe",
    "slug": "ekwe",
    "version": "1.0.0",
    "scheme": "ekwe",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ekwe"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090B"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "package": "com.anonymous.ekwe"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/splash-icon.png",
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-speech-recognition",
      [
        "@sentry/react-native/expo",
        {
          "organization": "airwaybill",
          "project": "javascript-nextjs"
        }
      ],
      "@sentry/react-native",
      "expo-widgets",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-widgets",
      "./modules/ekwe-native/app.plugin.js",
      [
        "expo-share-intent",
        {
          "android": {
            "mimeType": ["audio/*", "text/*"]
          },
          "ios": {
            "mimeType": [
              "public.audio",
              "public.mpeg-4-audio",
              "org.xiph.opus",
              "org.xiph.ogg-audio",
              "public.text",
              "public.plain-text",
              "public.url"
            ]
          }
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/fonts/*"
    ]
  }
}