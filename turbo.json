{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["CI", "NODE_ENV", "APP_ENV"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:ci": {
      "dependsOn": ["^typecheck"],
      "env": ["COVERAGE"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "android": {
      "cache": false,
      "persistent": true
    },
    "ios": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["APP_ENV", "SENTRY_ORG", "SENTRY_PROJECT"]
    },
    "//#gen:tokens": {
      "cache": false
    },
    "//#gen:icons": {
      "cache": false
    },
    "//#format": {
      "cache": false
    }
  }
}
